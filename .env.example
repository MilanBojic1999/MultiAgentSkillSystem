# --- LLM endpoint (any OpenAI-compatible server: vLLM, OpenRouter, Ollama) ---
LLM_URL=http://localhost:8000/v1
LLM_MODEL=your-model-name          # must match the server's --model flag
LLM_KEY=not-needed-for-vllm        # any non-empty string works for vLLM

# --- Orchestrator (planner wants low temperature for strict JSON) ---
ORCHESTRATOR_TEMPERATURE=0.1

# --- Paths ---
# Optional: defaults to agents/agent_config.json relative to the repo root.
CONFIG_PATH=agents/agent_config.json

# --- Graph selection ---
# Which graph in graphs/ the API runs when a request does not name one.
# Any module in graphs/ defining build() is available; see GET /graphs.
DEFAULT_GRAPH=parallel

# --- MCP server URLs ---
# Optional: MCP server endpoints (used in agents/agent_config.json via ${VAR}
# references). Not required if no agent uses MCP servers.
# YOTTA_MCP_URL=http://your-mcp-server:8001/mcp

# --- Logging ---
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FILE=langgraph_smart_reasoning.log   # empty string disables file logging
LOG_CONSOLE=false                  # true = also emit log events to stderr
DEBUG=false                        # true = API error responses include full tracebacks

# --- Optional: LangSmith tracing ---
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=agent-skills
